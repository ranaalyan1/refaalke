# ---- Base mainnet (reads) ------------------------------------------------
# Public RPC (Alchemy/Infura/LLRPC in production)
BASE_RPC_URL=https://mainnet.base.org
# First deployment block of the ERC-8004 Identity Registry on Base.
ERC8004_FROM_BLOCK=28800000

# ---- Explorer API (funding-cluster + x402 forensics) ---------------------
# Etherscan v2 unified key works for Base (chainid 8453); a legacy
# api.basescan.org key also works. Respect 5 req/s free-tier limit.
BASESCAN_API_KEY=YOUR_BASESCAN_API_KEY

# ---- IPFS pinning (snapshot URIs) ----------------------------------------
# Pinata JWT (https://api.pinata.cloud/pinning/pinJSONToIPFS)
PINATA_JWT=eyJ...
# Optional custom IPFS API for self-hosted (e.g. Kubo) pinning
# IPFS_API_URL=http://127.0.0.1:5001/api/v0
# Gateway used when returning URIs (contract also has a 2-gateway fallback)
IPFS_GATEWAY=https://ipfs.io/ipfs/

# ---- GenLayer (keeper writes) --------------------------------------------
# Private key of the keeper wallet = contract `owner` (commit_daily_case)
# and the wallet that calls run_verdict. NEVER a player hot wallet.
GENLAYER_PRIVATE_KEY=0xabc...
GENLAYER_NETWORK=bradbury
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ---- USDC (x402 volume, Base mainnet) ------------------------------------
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# ---- Store ---------------------------------------------------------------
STORE_DIR=./store
LOG_DIR=./logs
